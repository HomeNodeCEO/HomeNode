{
  "name": "homenode-mobile",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/completion.test.ts test/config.test.ts test/custom-appraisal.test.ts test/offline-sync.test.ts test/photos.test.ts test/sketch.test.ts test/target-fields.test.ts test/uad-entities.test.ts test/workflows.test.ts",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "expo": "57.0.15",
    "expo-auth-session": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "~57.0.12",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.87.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.18",
    "expo-doctor": "^1.18.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo"
      ]
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
