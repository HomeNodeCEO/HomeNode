# PostgreSQL connection used by the scraper API and workers. Supply this from
# the deployment secret manager; never commit a real value.
DATABASE_URL=postgresql://user:password@localhost:5432/homenodedb

# Comma-separated browser origins in addition to the built-in HomeNode
# production, UAD staging, and localhost origins. Remote origins require HTTPS.
SCRAPER_CORS_ORIGINS=https://preview.example.com

# This obsolete scraper-side signup PDF route is not used by the current
# HomeNode frontend. Leave disabled unless the route is intentionally restored
# with its own authentication, rate limiting, and private artifact storage.
ENABLE_LEGACY_SIGNUP_PDF=false

# Process one field-completeness repair per this many normal campaign accounts.
SCRAPE_FIELD_REPAIR_EVERY_ACCOUNTS=5
