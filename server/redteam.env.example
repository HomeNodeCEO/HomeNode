# This file contains names and safe placeholders only. Never commit populated values.
NODE_ENV=production
HOMENODE_DEPLOYMENT_ENVIRONMENT=redteam
REDTEAM_ISOLATION_STRICT=true
REDTEAM_DATA_CLASSIFICATION=synthetic_only
UAD_WORKSPACE_ENABLED=true
MOBILE_INSPECTION_ENABLED=true
UAD_SECURITY_STRICT=true
UAD_AUTHENTICATION_REQUIRED=true
UAD_RATE_LIMIT_ENABLED=true
UAD_RATE_LIMIT_WINDOW_MS=60000
UAD_RATE_LIMIT_MAX=120
# Render's Cloudflare edge overwrites this single-address header. The app falls
# back to req.ip if it is ever absent or malformed.
UAD_RATE_LIMIT_CLIENT_IP_HEADER=cf-connecting-ip
TRUST_PROXY_HOPS=1
CORS_ORIGIN=https://uad-redteam.example.com

# Bound slow clients, stuck queries, connection churn, and deploy shutdowns.
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_CONNECTIONS_CHECK_INTERVAL_MS=1000
HTTP_MAX_HEADERS_COUNT=100
HTTP_MAX_REQUESTS_PER_SOCKET=500
DATABASE_POOL_SIZE=8
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=35000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=25000

# Synthetic red-team resources only; never reuse staging or production values.
DATABASE_URL=postgresql://redteam_user:REDACTED@redteam-db.invalid/homenode_redteam
UAD_OBJECT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=REDACTED_REDTEAM_ACCOUNT
R2_ACCESS_KEY_ID=REDACTED_REDTEAM_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REDACTED_REDTEAM_SECRET_KEY
R2_BUCKET=homenode-uad-redteam
REDTEAM_OIDC_PROVIDER=static_redteam
OIDC_ISSUER=https://uad-redteam-identity.example.invalid
OIDC_AUDIENCE=homenode-redteam-api
OIDC_JWKS_URI=https://REDACTED_PUBLIC_KEY_HOST/uad-redteam-jwks.json
# WorkOS AuthKit uses a generated client ID as the access-token audience. When
# WorkOS is used, replace OIDC_AUDIENCE above and set all four markers below.
# The application name must identify "red team", the client marker must exactly
# equal OIDC_AUDIENCE, and the JWKS URL must be /oauth2/jwks on the issuer host.
# To use WorkOS instead, replace REDTEAM_OIDC_PROVIDER above and set all four
# WorkOS markers below.
# REDTEAM_OIDC_PROVIDER=workos_authkit
# REDTEAM_OIDC_APPLICATION_ID=app_REDACTED_REDTEAM_APPLICATION
# REDTEAM_OIDC_APPLICATION_NAME=HomeNode UAD Red Team
# REDTEAM_OIDC_CLIENT_ID=client_REDACTED_REDTEAM_CLIENT
# JSON object mapping every persona key documented in UAD_RED_TEAM_ENVIRONMENT.md
# to the subject claim of its dedicated synthetic OIDC identity.
REDTEAM_OIDC_SUBJECTS_JSON={}
REDTEAM_FIXTURE_ACCOUNT_ID=UAD-REDTEAM-SFR-0001

# External providers and background data workers remain disabled. Do not copy
# their URLs, client IDs, secrets, mail configuration, or Census key here.
UAD_COMPLIANCE_API_ENABLED=false
FANNIE_UAD_COMPLIANCE_ENABLED=false
FREDDIE_UAD_COMPLIANCE_ENABLED=false
TRESTLE_ENABLED=false
TRESTLE_REPLICATION_ENABLED=false
TRESTLE_MEDIA_ENABLED=false
DOCUMENT_OCR_PROVIDER=disabled
LOCATION_BACKFILL_ENABLED=false
CENSUS_GEOGRAPHY_ENABLED=false
