{
  "name": "dcad-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:checked": "vite build && node scripts/checkBundleBudget.mjs",
    "lint": "eslint .",
    "lint:ci": "node scripts/checkLintBudget.mjs",
    "quality:source": "node scripts/checkSourceBudget.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"scripts/test*.mjs\"",
    "verify:deployed-security-headers": "node scripts/verifyFrontendSecurityHeaders.mjs",
    "preview": "vite preview",
    "test:adjustments": "node scripts/testComparableAdjustments.mjs",
    "test:ratings": "node scripts/testConditionQualityRatings.mjs",
    "test:condition-study": "node scripts/testConditionQualityRatings.mjs",
    "test:neighborhood": "node --experimental-strip-types scripts/testNeighborhoodAutomation.mjs",
    "test:market-area": "node --experimental-strip-types scripts/testMarketAreaAutomation.mjs",
    "test:comparable-presentation": "node --experimental-strip-types scripts/testComparableSalesPresentation.mjs",
    "test:property-report-presentation": "node --experimental-strip-types scripts/testPropertyReportPresentation.mjs",
    "test:property-report-assignment": "node --experimental-strip-types scripts/testPropertyReportAssignment.mjs",
    "test:custom-appraisal-autosave": "node --experimental-strip-types scripts/testCustomAppraisalAutosave.mjs",
    "test:assignment-file-selection": "node --experimental-strip-types scripts/testAssignmentFileSelection.mjs",
    "test:report-file-workflow": "node scripts/testReportFileWorkflow.mjs",
    "test:timed-request-cache": "node --experimental-strip-types scripts/testTimedRequestCache.mjs",
    "test:zoning-evidence-presentation": "node --experimental-strip-types scripts/testZoningEvidencePresentation.mjs",
    "test:application-session-editor": "node --experimental-strip-types scripts/testApplicationSessionEditor.mjs",
    "test:uad-auth": "node --experimental-strip-types scripts/testUadAuth.mjs",
    "test:property-tax-isolation": "node --experimental-strip-types scripts/testPropertyTaxIsolation.mjs",
    "test:property-tax-case": "node --experimental-strip-types scripts/testPropertyTaxCase.mjs",
    "test:property-tax-comparables": "node --test --experimental-strip-types scripts/testPropertyTaxComparableAnalysis.mjs scripts/testPropertyTaxComparableGrid.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.540.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.3.6"
  }
}
