## Required for DB-backed routes. Not needed if you only test /api/signup/email.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

## CORS: allow your frontend dev server to call the API
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Required for explicit manual housing, condition/quality, and verified-attribute saves.
# Use a long, random value and enter it only in the in-app editor prompt.
# HOMENODE_EDITOR_KEY=replace-with-a-long-random-editor-key

## Bulk location and Census workers are OFF in the web process by default.
## Production should run `npm run maintenance:scheduled` from a scheduled
## Render job. Turn either flag on only as a temporary rollback/fallback.
# LOCATION_BACKFILL_ENABLED=false
# LOCATION_BACKFILL_INTERVAL_MS=30000
# LOCATION_BACKFILL_SEED_INTERVAL_MS=300000
# LOCATION_BACKFILL_INITIAL_DELAY_MS=3000
# LOCATION_BACKFILL_BATCH_SIZE=50
# LOCATION_BACKFILL_SEED_LIMIT=1000
# LOCATION_BACKFILL_MAX_ATTEMPTS=5

# CENSUS_GEOGRAPHY_ENABLED=false
# CENSUS_GEOGRAPHY_BATCH_SIZE=1000
# CENSUS_GEOGRAPHY_SEED_LIMIT=25000

## Web request performance monitoring. Slow routes are normalized before being
## logged so property/file identifiers do not create unbounded log cardinality.
# PERFORMANCE_WARN_MS=750
# PERFORMANCE_SLOW_MS=1500
# PERFORMANCE_WINDOW_SIZE=500
# PERFORMANCE_LOG_ALL=false
# DATABASE_POOL_SIZE=10
# DATABASE_CONNECTION_TIMEOUT_MS=10000

## UAD 3.6 workspace. Keep disabled until the additive UAD migration has been
## applied to the target environment with `npm run migrate:uad`.
# UAD_WORKSPACE_ENABLED=false

## Mobile inspection API. Apply `npm run migrate:mobile` after the UAD
## migrations, provision OIDC identities, then enable this flag. The API uses
## standards-based OIDC discovery/JWKS and is not tied to one vendor.
# MOBILE_INSPECTION_ENABLED=false
# MOBILE_RECENT_FILE_DAYS=30
# OIDC_ISSUER=https://your-tenant.example.com
# OIDC_AUDIENCE=https://api.homenode.com/mobile
# OIDC_JWKS_URI=
# OIDC_CLOCK_TOLERANCE_SECONDS=60

## Private Cloudflare R2 storage for appraisal photos, sketches, floor plans,
## supporting documents, native reports, XML, and delivery packages. Mobile
## clients receive short-lived presigned URLs and never receive these secrets.
# UAD_OBJECT_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=homenode-uad
# R2_UPLOAD_URL_TTL_SECONDS=900

## UAD 3.6 Compliance API. Keep disabled until MISMO XML generation, local
## subschema validation, GSE nonproduction onboarding, and verification are
## complete. Store all client secrets only in the deployment secret manager.
# UAD_COMPLIANCE_API_ENABLED=false
# FANNIE_UAD_COMPLIANCE_ENVIRONMENT=acpt
# FANNIE_UAD_COMPLIANCE_BASE_URL=
# FANNIE_UAD_COMPLIANCE_TOKEN_URL=
# FANNIE_UAD_COMPLIANCE_CLIENT_ID=
# FANNIE_UAD_COMPLIANCE_CLIENT_SECRET=
# FANNIE_UAD_COMPLIANCE_SCOPE=
# FREDDIE_UAD_COMPLIANCE_ENVIRONMENT=clve
# FREDDIE_UAD_COMPLIANCE_BASE_URL=
# FREDDIE_UAD_COMPLIANCE_TOKEN_URL=
# FREDDIE_UAD_COMPLIANCE_CLIENT_ID=
# FREDDIE_UAD_COMPLIANCE_CLIENT_SECRET=
# FREDDIE_UAD_COMPLIANCE_SCOPE=
# UAD_COMPLIANCE_API_TIMEOUT_MS=30000

## Scheduled maintenance bounds. The routine job runs Census, sale-coordinate,
## and incremental Dallas parcel-context work. Road context has its own slower
## monthly command (`npm run maintenance:roads`).
## Phase-2 road, rail, flood, and municipal-zoning refreshes can instead run
## together with `npm run maintenance:context`; each source retains its last
## successful local mirror if a provider is unavailable.
# MAINTENANCE_MAX_RUNTIME_MINUTES=45
# MAINTENANCE_CENSUS_MAX_BATCHES=3
# MAINTENANCE_LOCATION_MAX_BATCHES=4
# MAINTENANCE_INFLUENCE_MAX_BATCHES=4
# MAINTENANCE_INFLUENCE_BATCH_SIZE=100
# MAINTENANCE_INFLUENCE_SEED_LIMIT=10000
# MAINTENANCE_DB_POOL_SIZE=4
# MAINTENANCE_STATEMENT_TIMEOUT_MS=900000
# PROPERTY_CONTEXT_FETCH_CONCURRENCY=3
# PROPERTY_CONTEXT_HAZARD_BATCH_SIZE=1000
# PROPERTY_CONTEXT_ZONING_BATCH_SIZE=1000

## Gridics PropZone is a licensed fallback only. Official municipal zoning GIS
## remains first priority. Do not enable this until Gridics supplies the
## contracted API base URL, credentials, coverage, and redistribution terms.
# GRIDICS_PROPZONE_ENABLED=false
# GRIDICS_PROPZONE_BASE_URL=
# GRIDICS_PROPZONE_API_KEY=

## Optional non-Dallas enrichment. Leave disabled until the Trestle agreement
## and credentials cover the intended NTREIS use. Dallas County is rejected by
## the worker even when this flag is enabled.
# TRESTLE_ENABLED=false
# TRESTLE_CLIENT_ID=
# TRESTLE_CLIENT_SECRET=
# TRESTLE_ORIGINATING_SYSTEM_NAME=NTREIS
# TRESTLE_BASE_URL=https://api.cotality.com/trestle/odata
# TRESTLE_TOKEN_URL=https://api.cotality.com/trestle/oidc/connect/token
# TRESTLE_SCOPE=api

## Census ACS ZIP profile enrichment. A free Census API key is required.
## The year defaults to 2024 until a newer ACS 5-year profile release is available.
# CENSUS_API_KEY=
# CENSUS_ACS_YEAR=2024

## Optional overrides if an official county changes its parcel service.
# COLLIN_GIS_QUERY_URL=
# COLLIN_GIS_ACCOUNT_FIELDS=geoID,propID
# TARRANT_GIS_QUERY_URL=
# TARRANT_GIS_ACCOUNT_FIELDS=ACCOUNT,TAXPIN
# DENTON_GIS_QUERY_URL=
# DENTON_GIS_ACCOUNT_FIELDS=prop_id
# ROCKWALL_GIS_QUERY_URL=
# ROCKWALL_GIS_ACCOUNT_FIELDS=prop_id

## SMTP configuration (choose ONE of the two approaches below)

# 1) Single URL form (recommended). Example for Gmail with app password (port 465):
# SMTP_URL=smtps://YOUR_GMAIL_ADDRESS:APP_PASSWORD@smtp.gmail.com:465

# 2) Host/port/auth form
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=YOUR_GMAIL_ADDRESS
# SMTP_PASS=APP_PASSWORD

# Optional: override the From header
# MAIL_FROM=YOUR_GMAIL_ADDRESS

# Optional: listen port (defaults to 4000)
# PORT=4000

## Scheduled property-influence maintenance
# Each sale-level spatial query is isolated so one malformed or unusually
# complex parcel cannot keep the maintenance service running indefinitely.
# MAINTENANCE_INFLUENCE_MAX_BATCHES=40
# MAINTENANCE_INFLUENCE_BATCH_SIZE=100
# MAINTENANCE_INFLUENCE_CONCURRENCY=4
# MAINTENANCE_INFLUENCE_STATEMENT_TIMEOUT_MS=60000
